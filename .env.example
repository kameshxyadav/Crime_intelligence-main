# ==============================================================================
# Cross-Station Crime Intelligence - configuration
#
# This is THE one place configuration lives:   <repo root>/.env
#   cp .env.example .env     then fill in the values marked  <-- FILL IN
#
# - docker compose reads it automatically (env_file, optional).
# - `docker run --env-file .env oah-submission` also works.
# - Host runs (`python run.py`) read it too. A legacy backend/.env is still read if present.
# - .env is gitignored and excluded from the Docker build context: it is never baked into an image.
# - Real environment variables always win over this file.
#
# To run with NO credentials and NO external services, skip all of this:
#   docker run -p 8000:8000 -e SAMPLE_MODE=true oah-submission
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sample mode (offline). Runs the REAL Planner/Finder/Skeptic/verifier/Reporter loop over
#    data/generated, with verified scenarios and deterministic evidence grounding.
#    Every replayed call is labelled in the trace. No Zetaris, Nightshift or network needed.
# ------------------------------------------------------------------------------
SAMPLE_MODE=false

# ------------------------------------------------------------------------------
# 2. Zetaris NDP (live data layer)
# ------------------------------------------------------------------------------
ZETARIS_ENABLED=true
ZETARIS_USERNAME=admin@zetaris.com
# <-- FILL IN the password (or set ZETARIS_API_TOKEN instead)
ZETARIS_PASSWORD=
ZETARIS_API_TOKEN=
ZETARIS_ORG_ID=1
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_MAX_QUERY_ROWS=500
ZETARIS_DATABASE=default

# Match YOUR Zetaris layout. A table value containing a dot is used as-is (fully qualified, e.g.
# crime_police_db.police_incidents - then leave ZETARIS_NAMESPACE empty); a bare name is prefixed with ZETARIS_NAMESPACE.
# Check what exists with:  SHOW TABLES IN <catalog>   (e.g. in the Zetaris UI at http://localhost:3000)
ZETARIS_NAMESPACE=lightning.ndp_filestore
ZETARIS_TABLE_POLICE_INCIDENTS=police_incidents
ZETARIS_TABLE_NEWSPAPER_REPORTS=newspaper_reports
ZETARIS_TABLE_WITNESS_REPORTS=witness_reports
ZETARIS_TABLE_CCTV_REPORTS=cctv_reports
ZETARIS_TABLE_FORENSIC_REPORTS=forensic_reports

# URLs. Host runs default to localhost. Inside docker compose or docker run, set
# DOCKER_ZETARIS_BASE_URL to host.docker.internal:8888 automatically.
ZETARIS_BASE_URL=http://localhost:8888
ZETARIS_AUTH_URL=http://localhost:8889
DOCKER_ZETARIS_BASE_URL=http://host.docker.internal:8888
DOCKER_ZETARIS_AUTH_URL=http://host.docker.internal:8889
ZETARIS_JDBC_HOST=localhost
ZETARIS_JDBC_PORT=10000

# ------------------------------------------------------------------------------
# 3. Nightshift & NVIDIA Nemotron (all model calls go through it)
#    Provide the key ONE of three ways:
#    a) Direct NVIDIA NIM API: set NIGHTSHIFT_BASE_URL=https://integrate.api.nvidia.com/v1
#       and NIGHTSHIFT_API_KEY=<nvapi-... key from build.nvidia.com [Generate API Key]>
#    b) Local Meterless Nightshift proxy: set NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
#       and leave NIGHTSHIFT_API_KEY blank to auto-read proxy-token
#    c) NIGHTSHIFT_API_KEY_FILE=<path to token file> (Docker secrets / bind mounts)
# ------------------------------------------------------------------------------
# <-- FILL IN the token/key here:
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_API_KEY_FILE=
NIGHTSHIFT_BASE_URL=https://integrate.api.nvidia.com/v1
DOCKER_NIGHTSHIFT_BASE_URL=http://host.docker.internal:8088/v1
NIGHTSHIFT_APP_NAME=crime-intel
NIGHTSHIFT_TIMEOUT_SECONDS=90
NIGHTSHIFT_MAX_RETRIES=3

# Models. Blank role = NIGHTSHIFT_MODEL (Lightning).
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIGHTSHIFT_MODEL_PLANNER=
NIGHTSHIFT_MODEL_FINDER=
NIGHTSHIFT_MODEL_SKEPTIC=nvidia/nemotron-3-ultra-550b-a55b
NIGHTSHIFT_MODEL_REPORTER=
NIGHTSHIFT_MODEL_EMBEDDING=nvidia/nemotron-3-embed-1b
NIGHTSHIFT_MODEL_RERANK=
NIGHTSHIFT_MODEL_FALLBACK=
NIGHTSHIFT_SKEPTIC_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 4. Workflow budgets (the run always terminates)
# ------------------------------------------------------------------------------
WORKFLOW_MAX_ITERATIONS=3
WORKFLOW_MAX_MODEL_CALLS=24
WORKFLOW_TIME_BUDGET_SECONDS=900
WORKFLOW_RETRIEVAL_LIMIT=10
WORKFLOW_EVIDENCE_LIMIT_PER_SOURCE=8

# ------------------------------------------------------------------------------
# 5. Meterless engines
#    METERLESS_ENGINE_DIR: the host's Nightshift engine directory (when installed).
#    METERLESS_ENGINE_BACKEND: auto | mounted | reference. "auto" uses mounted engines
#    if present, falling back to built-in reference engines safely.
# ------------------------------------------------------------------------------
METERLESS_ENGINE_DIR=/Applications/Nightshift.app/Contents/Resources/engine/js/engine
METERLESS_WORLD_MODEL_PATH=/Applications/Nightshift.app/Contents/Resources/engine/js/engine/worldmodel.js
METERLESS_WORLD_DIR=
METERLESS_ENGINE_BACKEND=auto
HMEM_ENABLED=true
HMEM_SCOPE=crime-intel
STATE_DIR=../.state

# ------------------------------------------------------------------------------
# 6. App & CORS
# ------------------------------------------------------------------------------
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
LOCAL_DATA_DIR=data/generated
